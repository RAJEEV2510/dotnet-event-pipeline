{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Messaging": {
    "Transport": "RabbitMQ"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "Topic": "events",
    "DeadLetterTopic": "events-dlq",
    "GroupId": "event-processor",
    "Partitions": 6
  },
  "RabbitMQ": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "ExchangeName": "events_exchange",
    "QueueName": "events_queue",
    "DeadLetterExchange": "events_dlx",
    "DeadLetterQueue": "events_dlq",
    "PrefetchCount": 250
  },
  "PostgreSQL": {
    "ConnectionString": "Host=localhost;Port=54321;Database=postgres;Username=postgres;Password=password;"
  }
}
